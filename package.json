{
  "name": "install-bridge",
  "version": "2.0.1",
  "description": "Create install badges for any website or README file",
  "type": "commonjs",

  "bin": {
    "install-bridge": "bin/install-bridge.js"
  },

  "scripts": {
    "test": "node tests/core.test.js && node tests/cli.test.js && node tests/server.test.js",
    "start": "node src/server/server.js",
    "prepack": "npm test",
    "verify-pack": "npm pack --dry-run 2>&1 | grep 'npm notice' | grep -E '(bin/|src/|README|LICENSE)'"
  },

  "keywords": [
    "install",
    "installer",
    "badge",
    "distribution",
    "repository",
    "open-source",
    "cli",
    "http"
  ],

  "author": "Don Feeney",
  "license": "SEE LICENSE IN LICENSE",

  "engines": {
    "node": ">=18.0.0"
  },

  "repository": {
    "type": "git",
    "url": "https://github.com/dfeen87/Install-Bridge.git"
  },

  "bugs": {
    "url": "https://github.com/dfeen87/Install-Bridge/issues"
  },

  "homepage": "https://github.com/dfeen87/Install-Bridge",

  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ]
}
